{
  "installCommand": "npm install --omit=dev",
  "rewrites": [
    { "source": "/api", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/jobs.json,data/jobs-config.json,data/kiosk-ads.json",
      "excludeFiles": "{assets/**,admin/**,mobile/**,styles/**,index.html,electron/**}",
      "maxDuration": 60
    }
  }
}
