# Brevo (transactional email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CSUN Career Center

# Admin API password (must match admin dashboard password)
ADMIN_PASSWORD=career1

# Server port (default 3000; Vercel sets PORT automatically in local dev)
PORT=3000

# ─── GitHub Pages + Vercel split hosting ───────────────────────────────────
# GitHub Pages serves static files only. Deploy the API to Vercel (vercel.json),
# then set apiBaseUrl in config.json to your Vercel URL, e.g.:
#   https://interactive-kiosk.vercel.app
# Or deploy the entire repo to Vercel and use that URL directly.

# Optional: server-side GitHub commits for admin API ad uploads (not required when
# using the admin dashboard's GitHub PAT upload flow).
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main
